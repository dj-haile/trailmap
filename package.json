{
  "name": "trailmap",
  "productName": "Trailmap",
  "version": "0.3.0",
  "description": "A visual quarterly map of your work — goal rings, initiatives, people-shaped dependencies, one move at a time.",
  "main": "electron/main.js",
  "author": "Dj Haile <dj.haile@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/dj-haile/trailmap.git"
  },
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "npm run check:renderer && node --test \"test/unit/*.test.mjs\"",
    "test:e2e": "playwright test --config test/e2e/playwright.config.js",
    "check:renderer": "node scripts/check-renderer-purity.js",
    "dist": "electron-builder --mac dmg --universal"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "electron": "^43.1.1",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.dj.trailmap",
    "productName": "Trailmap",
    "files": [
      "electron/**/*",
      "renderer/**/*",
      "fixtures/**/*",
      "assets/**/*"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "identity": null,
      "icon": "assets/icon.png"
    },
    "dmg": {
      "background": "assets/dmg-background.png",
      "window": {
        "width": 660,
        "height": 420
      },
      "iconSize": 110,
      "contents": [
        {
          "x": 170,
          "y": 220,
          "type": "file"
        },
        {
          "x": 490,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  },
  "engines": {
    "node": ">=20.17.0"
  }
}
